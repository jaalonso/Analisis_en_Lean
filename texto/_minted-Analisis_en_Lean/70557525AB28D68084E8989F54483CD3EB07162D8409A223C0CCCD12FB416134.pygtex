\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Una subsucesión se obtiene aplicando a la sucesión original una}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} función de extracción; es decir, una función φ : ℕ → ℕ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} estrictamente creciente. Por ejemplo, la subsucesión}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    u₀, u₂, u₄, u₆, ...}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} se obtiene con la función de extracción φ definida por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} φ(n) = 2n.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Las definiciones anteriores se formalizan en Lean 4 como:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}\PYGZhy{} φ es una función de extracción.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    def extraccion (φ : ℕ → ℕ) :=}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      StrictMono φ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}\PYGZhy{} v es una subsucesión de u.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    def subsucesion (v u : ℕ → ℝ) :=}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ∃ φ, extraccion φ ∧ v = u ∘ φ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}\PYGZhy{} a es el límite de u.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    def LimSuc (u : ℕ → ℝ) (a : ℝ) :=}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ∀ ε \PYGZgt{} 0, ∃ k : ℕ, ∀ n ≥ k, |u n \PYGZhy{} a| \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostrar que toda subsucesión de una sucesión convergente}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} converge al mismo límite que la sucesión.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}


\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Usaremos el siguiente lema: Si φ es una función de extracción,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n, n ≤ φ(n)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por ser v una subsucesión de u, existe una función de}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} extracción φ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    v = u ∘ φ                                                (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que para cada ε \PYGZgt{} 0, existe un k ∈ ℕ tal}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}     ∀ n ≥ k, |v(n) \PYGZhy{} a| \PYGZlt{} ε                                 (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que a es el límite de u, , existe un k ∈ ℕ tal}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}     ∀ n ≥ k, |u(n) \PYGZhy{} a| \PYGZlt{} ε                                 (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que k verifica (1). Para ello, sea n ≥ k. Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    φ(n) ≥ k                                                 (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ya que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    φ(n) ≥ n    [por el Lema]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         ≥ k}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |v(n) \PYGZhy{} a| = |(u ∘ φ )(n) \PYGZhy{} a|    [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}               = |u(φ(n)) \PYGZhy{} a|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}               \PYGZlt{} ε                    [por (2) y (4)]}

