\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea ε \PYGZgt{} 0. Como aₙ converge a L, existe N₁ tal que si n ≥ N₁,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ − L| \PYGZlt{} 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto, para n ≥ N₁}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| = |aₙ − L + L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         ≤ |aₙ − L| + |L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         \PYGZlt{} 1 + |L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Definamos}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    C = 1 + |L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    C \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, para n ≥ N₁}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| ≤ C}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Ahora, como aₙ converge a L, existe N₂ tal que si n ≥ N₂,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ − L| \PYGZlt{} ε/(2(|M| + 1))}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por otra parte, como bₙ converge a M, existe N₃ tal que si}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} n ≥ N₃, entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |bₙ − M| \PYGZlt{} ε/(2C)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    N = máx⁡\PYGZob{}N₁,N₂,N₃\PYGZcb{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Si n ≥ N, entonces se cumplen las tres desigualdades}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} anteriores. Ahora estimamos:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙbₙ − LM|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sumamos y restamos aₙM:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    aₙbₙ − LM = aₙbₙ − aₙM + aₙM − LM.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙbₙ − LM| = |aₙ(bₙ − M) + M(aₙ − L)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por la desigualdad triangular,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙbₙ − LM| ≤ |aₙ||bₙ − M| +|M||aₙ − L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Como n ≥ N₁,tenemos}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| ≤ C}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙbₙ − LM| ≤ C|bₙ − M| + |M||aₙ − L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Usando las cotas elegidas,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    C|bₙ − M| \PYGZlt{} C⋅ε/(2C)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = ε/2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |M||aₙ − L| \PYGZlt{} |M|⋅ε/(2(|M| + 1))}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Como}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |M|/(|M| + 1) \PYGZlt{} 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} se sigue que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |M|⋅ε/(2(|M| + 1)) \PYGZlt{} ε/2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙbₙ − LM| \PYGZlt{} ε/2 + ε/2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Así, para todo ε \PYGZgt{} 0 existe N tal que si n ≥ N, entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙbₙ − LM| \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Esto prueba que, para todo ε \PYGZgt{} 0, existe N tal que |aₙbₙ − LM| \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} siempre que n ≥ N, es decir, aₙbₙ converge a LM.}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones en Lean 4}
