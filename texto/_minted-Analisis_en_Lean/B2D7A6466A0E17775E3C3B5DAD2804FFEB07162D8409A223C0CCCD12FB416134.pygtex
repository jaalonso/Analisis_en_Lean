\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Lo demostramos por contradicción. Supongamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    L \PYGZgt{} M                                                    (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y llegaremos a la contradicción M \PYGZlt{} M.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} De (1), se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    L \PYGZhy{} M \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, usando esta cantidad en la convergencia de aₙ, se obtiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} un k tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |aₙ \PYGZhy{} L| \PYGZlt{} L \PYGZhy{} M                                (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En particular, para n = k (que satisface k ≥ k), de (2) se}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} obtiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₖ \PYGZhy{} L| \PYGZlt{} L \PYGZhy{} M                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Además,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    L \PYGZhy{} aₖ ≤ |aₖ \PYGZhy{} L|                                        (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ya que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    L \PYGZhy{} aₖ = \PYGZhy{}(aₖ \PYGZhy{} L)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}           ≤ |aₖ \PYGZhy{} L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Finalmente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M = L \PYGZhy{} (L \PYGZhy{} M)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZlt{} L \PYGZhy{} |aₖ \PYGZhy{} L|  [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ L \PYGZhy{} (L \PYGZhy{} aₖ)  [por (4)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = aₖ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ M             [porque M es cota superior de aₙ]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto, M \PYGZlt{} M.}

