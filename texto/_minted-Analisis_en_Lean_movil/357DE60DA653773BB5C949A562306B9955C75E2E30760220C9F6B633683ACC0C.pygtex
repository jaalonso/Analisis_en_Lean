\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} La demostración se basa en los siguientes lemas:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} + Lema 1: Si aₙ es de Cauchy, entonces existe un k ∈ ℕ tal}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   que para todo n ≥ k, |a n| \PYGZlt{} |a k| + 1.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} + Lema 2: Para cada k ∈ ℕ, existe un M ∈ ℝ tal que para}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   todo i \PYGZlt{} k, |a i| ≤ M.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En efecto, por el lema 1, existe un k ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   ∀ n ≥ k, |aₙ| \PYGZlt{} |aₖ| + 1                                  (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Además, por el Lema 2, existe un C ∈ ℝ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   ∀ i \PYGZlt{} k, |aᵢ| ≤ C                                         (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   M = máx(|aₖ| + 1, C)                                      (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos en primer lugar que M \PYGZgt{} 0. En efecto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M ≥ |aₖ| + 1  [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≥ 0 + 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En segundo lugar, veamos que para todo n ∈ ℕ, |aₙ| ≤ M. Lo}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} haremos distinguiendo dos casos.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 1: Supongamos que n \PYGZlt{} k. Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| ≤ C    [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         ≤ M    [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 2: Supongamos que n ≥ k. Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| ≤ |aₖ| + 1   [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         ≤ M          [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Falta la demostración de los lemas. Para demostrar el}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} primer lema, puesto que aₙ es de Cauchy, existe un k ∈ ℕ tal}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ i ≥ k, ∀ j ≥ k, |aᵢ \PYGZhy{} aⱼ| \PYGZlt{} 1                         (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que k cumple la condición; es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |aₙ| \PYGZlt{} |aₖ| + 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para ello, sea n ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces, por (4) y por ser k ≥ k, se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ \PYGZhy{} aₖ| \PYGZlt{} 1                                           (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| = |aₖ + (aₙ \PYGZhy{} aₖ)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         ≤ |aₖ| + |aₙ \PYGZhy{} aₖ|   [por la desigualdad triangular]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         \PYGZlt{} |aₖ| + 1           [por (5)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrar el lema 2, sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M = ∑ i ∈ range k, |aᵢ|                                 (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M = |a₀| + |a₁| + ... + |aₖ₋₁|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que M es la cota buscada; es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ i \PYGZlt{} k, |aᵢ| ≤ M}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para ello, sea i ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    i \PYGZlt{} k                                                   (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces, puesto que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ i ∈ range k, 0 ≤ |aᵢ|                                 (8)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por (7),}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    i ∈ range k                                             (9)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aᵢ| ≤ ∑ i ∈ range k, |aᵢ|    [por (8) y (9)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}         = M                      [por (6)]}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones en Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ========================}

