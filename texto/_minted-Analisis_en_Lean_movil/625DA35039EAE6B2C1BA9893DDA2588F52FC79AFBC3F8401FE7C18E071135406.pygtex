\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostrar que si a es una sucesión monótona que no es de Cauchy,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces existen ε \PYGZgt{} 0 y σ : ℕ → ℕ tales que, para todo k ∈ ℕ,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k · ε ≤ a(σᵏ(0)) − a(0),}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} donde σᵏ denota la k\PYGZhy{}ésima iterada de σ.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para ello, completar la siguiente teoría en Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    import Mathlib.Basic.Real.Basic}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    import Mathlib.Tactic}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    def IsCauchy \PYGZob{}X : Type*\PYGZcb{} [AddGroup X] [Lattice X] (a : ℕ → X) : Prop :=}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ∀ (ε : X), 0 \PYGZlt{} ε → ∃ N : ℕ, ∀ n ≥ N, ∀ m ≥ n, |a m \PYGZhy{} a n| \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    variable \PYGZob{}X : Type*\PYGZcb{} [CommRing X]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                         [LinearOrder X]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                         [IsStrictOrderedRing X]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    variable \PYGZob{}a : ℕ → X\PYGZcb{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    example}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      (ha : Monotone a)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      (hC : ¬ IsCauchy a)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      : ∃ (ε : X) (σ : ℕ → ℕ), 0 \PYGZlt{} ε ∧ ∀ k : ℕ, k * ε ≤ a (σ\PYGZca{}[k] 0) \PYGZhy{} a 0 :=}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    by sorry}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ==================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que a no es de Cauchy, existe un ε tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε \PYGZgt{} 0                                                    (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ N, ∃ n ≥ N, ∃ m ≥ n, ε ≤ |a(m) \PYGZhy{} a(n)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por tanto, existen τ y σ (funciones de ℕ en ℕ) tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ k, τ(k) ≥ k                                            (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ k, σ(k) ≥ τ(k)                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ k, ε ≤ |a(σ(k)) \PYGZhy{} a(τ(k))|                             (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que ε y σ cumplen la conclusión del ejercicio. En}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} primer lugar, se tiene que ε \PYGZgt{} 0 (por (1)). Solo falta}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ k, k · ε ≤ a(σᵏ(0)) \PYGZhy{} a(0)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y lo probaremos por inducción sobre k.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso base (k = 0).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    0 · ε = 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          ≤ 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          = a(0) \PYGZhy{} a(0)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          = a(σ⁰(0)) \PYGZhy{} a(0)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso inductivo. Supongamos que se cumple, para k,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k · ε ≤ a(σᵏ(0)) − a(0).                                 (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Queremos probar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (k + 1) · ε ≤ a(σᵏ⁺¹(0)) − a(0).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para abreviar, sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    m = σᵏ(0).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (k + 1) · ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = k · ε + ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [por álgebra]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ≤ (a(m) \PYGZhy{} a(0)) + |a(σ(m)) \PYGZhy{} a(τ(m))|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [por HI y (4)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = (a(m) \PYGZhy{} a(0)) + (a(σ(m)) \PYGZhy{} a(τ(m)))}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [por (3) y por ser a monótona]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = (a(m) \PYGZhy{} a(τ(m))) + (a(σ(m)) \PYGZhy{} a(0))}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [por álgebra]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ≤ 0 + (a(σ(m)) \PYGZhy{} a(0))}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [por (2) y por ser a monótona]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = a(σ(m)) \PYGZhy{} a(0)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [por álgebra]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = a(σᵏ⁺¹(0)) \PYGZhy{} a(0)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        [porque σ(m) = σ(σᵏ(0)) = σᵏ⁺¹(0)]}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones en Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ========================}

