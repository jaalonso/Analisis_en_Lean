\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea a la sucesión definida por a(n) = (\PYGZhy{}1)\PYGZca{}n. Supongamos que a es}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} convergente. Entonces, existe un L tal que a converge L. Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} existe un N ∈ ℕ tal que,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀n ≥ N, |a(n) \PYGZhy{} L| \PYGZlt{} 1/2                                      (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2 = |2|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |(1 \PYGZhy{} L) + (1 + L)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |(1 \PYGZhy{} L) + (\PYGZhy{}1)(\PYGZhy{}1 \PYGZhy{} L)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ |1 \PYGZhy{} L| + |(\PYGZhy{}1)(\PYGZhy{}1 \PYGZhy{} L)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |1 \PYGZhy{} L| + |\PYGZhy{}1 \PYGZhy{} L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |(\PYGZhy{}1)\PYGZca{}\PYGZob{}2N\PYGZcb{} \PYGZhy{} L| + |(\PYGZhy{}1)\PYGZca{}\PYGZob{}2N+1\PYGZcb{} \PYGZhy{} L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |a(2N) \PYGZhy{} L| + |a(2N+1) \PYGZhy{} L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZlt{} 1/2 + 1/2                            [por (1), 2N ≥ N y 2N+1 ≥ N]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego, 2 \PYGZlt{} 1 que es una contradicción.}

