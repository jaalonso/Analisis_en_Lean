\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que probar que para todo ε ∈ ℝ, si}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε \PYGZgt{} 0                                                          (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∃N ∈ ℕ)(∀n ∈ ℕ)[n ≥ N → |(a + b)(n) \PYGZhy{} (L + M)| \PYGZlt{} ε]           (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (1), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε/2 \PYGZgt{} 0                                                        (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (3) y porque el límite de a es L, se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∃N ∈ ℕ)(∀n ∈ ℕ)[n ≥ N → |a(n) \PYGZhy{} L| \PYGZlt{} ε/2]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea N₁ ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∀n ∈ ℕ)[n ≥ N₁ → |a(n) \PYGZhy{} L| \PYGZlt{} ε/2]                            (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (3) y porque el límite de b es M, se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∃N ∈ ℕ)(∀n ∈ ℕ)[n ≥ N → |b(n) \PYGZhy{} M| \PYGZlt{} ε/2]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea N₂ ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∀n ∈ ℕ)[n ≥ N₂ → |b(n) \PYGZhy{} M| \PYGZlt{} ε/2]                            (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea N = máx(N₁, N₂). Veamos que verifica la condición (1). Para ello,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} sea n ∈ ℕ tal que n ≥ N. Entonces, n ≥ N₁ y n ≥ N₂. Por tanto, por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} las propiedades (4) y (5) se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |a(n) \PYGZhy{} L| \PYGZlt{} ε/2                                               (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |b(n) \PYGZhy{} M| \PYGZlt{} ε/2                                               (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Finalmente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |(a + b)(n) \PYGZhy{} (L + M)| = |(a(n) + b(n)) \PYGZhy{} (L + M)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                           = |(a(n) \PYGZhy{} L) + (b(n) \PYGZhy{} M)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                           ≤ |a(n) \PYGZhy{} L| + |b(n) \PYGZhy{} M|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                           \PYGZlt{} ε / 2 + ε / 2                [por (6) y (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                           = ε}

