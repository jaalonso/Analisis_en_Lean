\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por el Reto 22, basta demostrar que la sucesión a tiene dos}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} subsucesiones que convergen a límites distintos. Para ello,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} consideramos las funciones φ₁ y φ₂ de ℕ en ℕ definidas por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    φ₁(n) = 2n}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    φ₂(n) = 2n + 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Ambas son funciones de extracción ya que, para todo i, j ∈ ℕ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} con i \PYGZlt{} j, se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    φ₁(i) = 2i \PYGZlt{} 2j = φ₁(j)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    φ₂(i) = 2i + 1 \PYGZlt{} 2j + 1 = φ₂(j)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Definimos las subsucesiones de a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    b₁ = a ∘ φ₁}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    b₂ = a ∘ φ₂}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Ambas subsucesiones son constantes (b₁ vale 1 y b₂ vale \PYGZhy{}1), ya}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que para todo n ∈ ℕ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    b₁(n) = a(2n) = (\PYGZhy{}1)²ⁿ = 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    b₂(n) = a(2n + 1) = (\PYGZhy{}1)²ⁿ⁺¹ = \PYGZhy{}1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego, aplicando el Reto 23 que dice \PYGZdq{}toda sucesión constante}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} converge a su valor\PYGZdq{}, b₁ converge a 1 y b₂ converge a \PYGZhy{}1. Como}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 1 ≠ \PYGZhy{}1, a tiene dos subsucesiones con límites distintos y, por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} el Reto 22, no es convergente.}

