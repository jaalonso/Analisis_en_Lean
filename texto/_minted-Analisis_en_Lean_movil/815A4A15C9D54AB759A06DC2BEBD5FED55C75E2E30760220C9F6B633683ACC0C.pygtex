\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε = (M \PYGZhy{} L) / 2                                                (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que L \PYGZlt{} M, se tiene que ε \PYGZgt{} 0. Y, usando las convergencias de}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} aₙ y bₙ, se tiene que existen k₁ y k₂ tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k₁, |aₙ \PYGZhy{} L| \PYGZlt{} ε                                         (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k₂, |bₙ \PYGZhy{} M| \PYGZlt{} ε                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k = máx(k₁, k₂)                                                (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, aₙ \PYGZlt{} bₙ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para ello, sea n ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k.                                                         (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces, (4) y (5), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k₁                                                         (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k₂                                                         (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    aₙ \PYGZlt{} (L + M) / 2                                               (8)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Efectivamente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    aₙ = aₙ \PYGZhy{} L + L}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       ≤ |aₙ \PYGZhy{} L| + L}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       \PYGZlt{} ε + L            [por (2) y (6)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       = (M \PYGZhy{} L) / 2 + L  [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       = (L + M) / 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos también que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    bₙ \PYGZgt{} (L + M) / 2                                              (9)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Efectivamente}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    bₙ = bₙ \PYGZhy{} M + M}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        \PYGZgt{} \PYGZhy{}ε + M               [por (3) y (7)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        = \PYGZhy{}((M \PYGZhy{} L) / 2) + M   [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        = (L + M) / 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Finalmente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    aₙ \PYGZlt{} (L + M) / 2  [por (8)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       \PYGZlt{} bₙ           [por (9)]}

