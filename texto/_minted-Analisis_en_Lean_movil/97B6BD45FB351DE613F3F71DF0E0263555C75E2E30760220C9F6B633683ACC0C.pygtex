\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Lo demostraremos por inducción en n.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso base: Para n = 0 se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    0 ≤ σ(0)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} porque 0 es el menor número natural.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso de inducción: Supongamos que la propiedad se cumple}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} para n; es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≤ σ(n)                                            (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tenemos que demostrarla para n+1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n+1 ≤ σ(n+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para ello, basta demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n \PYGZlt{} σ(n+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que se prueba con}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≤ σ(n)       [por (HI)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZlt{} σ(n+1)     [porque σ es estictamente creciente]}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones con Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} =========================}

