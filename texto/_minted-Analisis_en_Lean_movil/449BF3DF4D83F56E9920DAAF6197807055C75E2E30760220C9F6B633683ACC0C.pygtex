\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 1/L.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea bₙ la sucesión definida por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n, bₙ = 1/aₙ                                               (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que bₙ converge a 1/L. Para ello, sea ε \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} dado y hay que probar que existe un k tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |bₙ \PYGZhy{} 1/L| \PYGZlt{} ε                                      (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por el teorema EventualmenteMayorIgMitadAbsLimitePos,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} existe k₁ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k₁, |aₙ| ≥ |L|/2                                       (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Como L ≠ 0, se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |L| \PYGZgt{} 0                                                      (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε|L|²/2 \PYGZgt{} 0.                                                 (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por la convergencia de aₙ, existe k₂ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k₂, |aₙ \PYGZhy{} L| \PYGZlt{} ε|L|²/2                                 (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea                                                             (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k = máx(k₁, k₂).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que se verifica (2). Para ello, sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k                                                        (8)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (6), se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k₁}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por (3), se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| ≥ |L|/2                                                 (9)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que, junto con (4), asegura que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} así que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    aₙ ≠ 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y bₙ = 1/aₙ está bien definido.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Además, de (7) también se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k₂}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por (6), se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ \PYGZhy{} L| \PYGZlt{} ε|L|²/2                                          (10)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Finalmente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   |bₙ \PYGZhy{} 1/L| = |1/aₙ \PYGZhy{} 1/L|              [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = |(L \PYGZhy{} aₙ) / (aₙL)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = |L \PYGZhy{} aₙ| / |aₙL|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = |aₙ \PYGZhy{} L| / (|aₙ||L|)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              \PYGZlt{} (ε|L|²/2) / (|aₙ||L|)     [por (10)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              ≤ (ε|L|²/2) / (|L|/2)|L|)   [por (9)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = (ε|L|²/2) / (|L|²/2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = ε.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} con lo que se prueba (2).}

