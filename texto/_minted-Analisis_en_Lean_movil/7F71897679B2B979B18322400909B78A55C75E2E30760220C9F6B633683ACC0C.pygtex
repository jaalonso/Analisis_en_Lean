\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por inducción en n.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso base: Para n = 0 se tiene:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2n + 9 = 2·0 + 9}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}           = 9}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}           \PYGZlt{} 16}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}           = 2⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}           = 2⁰⁺⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}           = 2ⁿ⁺⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso inductivo: Suponiendo la hipótesis de inducción}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   2k + 9 ≤ 2ᵏ⁺⁴                                             (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   2(k+1) + 9 \PYGZlt{} 2⁽ᵏ⁺¹⁾⁺⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces, puesto que k ≥ 0, se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   2 ≤ 2ᵏ⁺⁴                                                  (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Efectivamente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2 ≤ 16}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = 2⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ 2ᵏ⁺⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2(k + 1) + 9 = (2k + 9) + 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                 ≤ 2ᵏ⁺⁴ + 2              [por HI]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                 ≤ 2ᵏ⁺⁴ + 2ᵏ⁺⁴           [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                 = 2 · 2ᵏ⁺⁴}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                 = 2⁽ᵏ⁺¹⁾⁺⁴}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones con Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} =========================}

