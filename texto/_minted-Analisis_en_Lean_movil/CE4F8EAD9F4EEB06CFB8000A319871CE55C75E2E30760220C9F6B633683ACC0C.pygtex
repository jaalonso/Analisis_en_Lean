\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 1ª demostración}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ===============}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En primer lugar demostraremos el siguiente lema auxiliar:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para todo m ≥ 4, se tiene m² ≤ 2ᵐ. Sea m ∈ ℕ, tenemos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    m ≥ 4 → m \PYGZca{} 2 ≤ 2 \PYGZca{} m}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} lo demostraremos por inducción en m.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso base: Para m = 0 se tiene, trivialmente que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    0 ≥ 4 → 0 \PYGZca{} 2 ≤ 2 \PYGZca{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso de inducción: Sea n ∈ ℕ que cumple la hipótesis de}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} inducción; es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ 4 → n \PYGZca{} 2 ≤ 2 \PYGZca{} n                               (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n + 1 ≥ 4 → (n + 1) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Suponiendo que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n + 1 ≥ 4                                            (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 1) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Lo haremmos por caso según (4 ≤ n).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Primer caso: Supongamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    4 ≤ n                                                (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces, demostramos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2 * n + 1 ≤ n \PYGZca{} 2                                    (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Efectivamente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2 * n + 1 ≤ 2 * n + 8}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              ≤ 2 * n + 2 * n   [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = 4 * n}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              ≤ n * n           [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = n \PYGZca{} 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 1) \PYGZca{} 2 = n \PYGZca{} 2 + 2 * n + 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                ≤ n \PYGZca{} 2 + n \PYGZca{} 2       [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = 2 * n \PYGZca{} 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                ≤ 2 * 2 \PYGZca{} n           [por HI y (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = 2 \PYGZca{} (n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Segundo caso: Supongamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ¬(4 ≤ n)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces, por (1), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n = 3}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 1) \PYGZca{} 2 = (3 + 1) \PYGZca{} 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = 16}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                ≤ 2 \PYGZca{} (3 + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = 2 \PYGZca{} (n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para concluir la demostración del ejercicio}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∃ k, ∀ n, (n + k) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + k)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} basta usar 4 como k y queda}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n, (n + 4) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que se demuestra con el lema auxiliar. En efecto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} sea n ∈ ℕ. Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n + 4 ≥ 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por el lema auxiliar,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 4) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 4).}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 2ª demostración}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ===============}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En primer lugar demostraremos el siguiente lema auxiliar:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para todo m ≥ 4, se tiene m² ≤ 2ᵐ. Sea m ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    m ≥ 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    m \PYGZca{} 2 ≤ 2 \PYGZca{} m}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} lo demostraremos por inducción generalizada en m a partir}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} de 4.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso base: Para m = 4 se tiene, trivialmente que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    4 \PYGZca{} 2 ≤ 2 \PYGZca{} 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso de inducción: Sea n ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    4 ≤ n                                                (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y que cumple la hipótesis de inducción; es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n \PYGZca{} 2 ≤ 2 \PYGZca{} n                                       (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 1) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Antes, demostramos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2 * n + 1 ≤ n \PYGZca{} 2                                    (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Efectivamente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    2 * n + 1 ≤ 2 * n + 8}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              ≤ 2 * n + 2 * n   [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = 4 * n}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              ≤ n * n           [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = n \PYGZca{} 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 1) \PYGZca{} 2 = n \PYGZca{} 2 + 2 * n + 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                ≤ n \PYGZca{} 2 + n \PYGZca{} 2       [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = 2 * n \PYGZca{} 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                ≤ 2 * 2 \PYGZca{} n           [por HI]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                = 2 \PYGZca{} (n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para concluir la demostración del ejercicio}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∃ k, ∀ n, (n + k) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + k)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} basta usar 4 como k y queda}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n, (n + 4) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que se demuestra con el lema auxiliar. En efecto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} sea n ∈ ℕ. Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n + 4 ≥ 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por el lema auxiliar,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n + 4) \PYGZca{} 2 ≤ 2 \PYGZca{} (n + 4).}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones con Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} =========================}

