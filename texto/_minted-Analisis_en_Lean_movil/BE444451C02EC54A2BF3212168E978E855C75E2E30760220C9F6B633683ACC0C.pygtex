\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por inducción en n.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso base: Para n = 0 se tiene:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n = 0 \PYGZlt{} 1 = 2⁰ = 2ⁿ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso inductivo: Suponiendo la hipótesis de inducción}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   k \PYGZlt{} 2ᵏ                                             (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   k+1 \PYGZlt{} 2ᵏ⁺¹}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} La demostración es}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k + 1 ≤ k + 2ᵏ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          \PYGZlt{} 2ᵏ + 2ᵏ    [por la HI]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          = 2 · 2ᵏ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          = 2ᵏ⁺¹}

