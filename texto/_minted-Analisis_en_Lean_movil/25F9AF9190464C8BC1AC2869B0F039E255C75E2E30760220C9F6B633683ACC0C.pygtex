\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por inducción en N.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Base: Para N = 0,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n \PYGZlt{} 0, |a n| ≤ ∑ k ∈ range 0, |a k|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} se verifica porque no hay ningún número natural menor que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 0.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso de inducción: Supongamos que N verifica la propiedad;}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}es decir,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n \PYGZlt{} N, |a n| ≤ ∑ k ∈ range N, |a k|               (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenmos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n \PYGZlt{} N + 1, |a n| ≤ ∑ k ∈ range (N + 1), |a k|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea n ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n \PYGZlt{} N + 1                                            (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |a n| ≤ ∑ k ∈ range (N + 1), |a k|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que se reduce a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |a n| ≤ ∑ k ∈ range N, |a k| + |a N|                 (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Lo probaremos distinguiendo casos según que n \PYGZlt{} N.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 1ª caso: Supongamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n \PYGZlt{} N,                                               (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |a n| ≤ ∑ k ∈ range N, |a k|         [por (HI) y (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}          ≤ ∑ k ∈ range N, |a k| + |a N|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 2ª caso: Supongamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ¬(n \PYGZlt{} N),                                            (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} entonces, por (1) y (4), la (2) se transforma en}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |a N| ≤ ∑ k ∈ range N, |a k| + |a N|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Cuya demostración se reduce a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    0 ≤ ∑ k ∈ range N, |a k|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que se verifica puesto que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ i ∈ range N, 0 ≤ |a i|}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones con Lean4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ========================}

\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n}{Mathlib.Data.Real.Basic}
