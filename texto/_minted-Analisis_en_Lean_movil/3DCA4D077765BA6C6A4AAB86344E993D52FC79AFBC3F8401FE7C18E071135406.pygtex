\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Lo demostraremos por reducción al absurdo. Supongamos que a no}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} es de Cauchy y que está acotada superiormente, y lleguemos a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} una contradicción.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por estar a acotada superiormente, existe un M tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n, a(n) ≤ M                                             (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por el lema del crecimiento lineal de los huecos de las}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} sucesiones monótonas que no son de Cauchy (del Reto 35),}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} existen ε y σ tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    0 \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ k, k · ε ≤ a(σᵏ(0)) \PYGZhy{} a(0)                              (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por la propiedad arquimediana, existe k ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M \PYGZhy{} a(0) \PYGZlt{} k · ε                                          (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para obtener una contradicción, demostraremos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M \PYGZlt{} M}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En efecto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    M = (M \PYGZhy{} a(0)) + a(0)          [por álgebra]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZlt{} k · ε + a(0)               [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ (a(σᵏ(0)) \PYGZhy{} a(0)) + a(0)   [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = a(σᵏ(0))                   [por álgebra]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ M                          [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Variante. En lugar de la propiedad arquimediana se puede usar la}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} función suelo: basta tomar}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k = ⌊(M \PYGZhy{} a(0)) / ε⌋ + 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ya que entonces (M \PYGZhy{} a(0)) / ε \PYGZlt{} k y, por tanto, se cumple (3).}

