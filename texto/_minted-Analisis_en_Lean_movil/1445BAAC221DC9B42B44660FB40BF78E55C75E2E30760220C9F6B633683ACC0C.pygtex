\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea a antítona y acotada inferiormente. Entonces existe un M}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n, M ≤ a(n)                                              (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Consideremos la sucesión \PYGZhy{}a. Veamos que es monótona y acotada}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} superiormente:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} + Monótona: si m ≤ n, entonces a(n) ≤ a(m) por ser a antítona}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   y, por tanto, \PYGZhy{}a(m) ≤ \PYGZhy{}a(n).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} + Acotada superiormente: por (1), \PYGZhy{}a(n) ≤ \PYGZhy{}M para todo n.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por el Reto 37, \PYGZhy{}a es de Cauchy. Por el Reto 38, \PYGZhy{}(\PYGZhy{}a) también}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} lo es. Como \PYGZhy{}(\PYGZhy{}a) = a, se concluye que a es de Cauchy.}

