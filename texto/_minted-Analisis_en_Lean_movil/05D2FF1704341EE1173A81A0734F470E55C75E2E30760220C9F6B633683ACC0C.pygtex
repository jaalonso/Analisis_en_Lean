\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Supongamos que la sucesión a es de Cauchy. Tenemos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} demostrar que \PYGZhy{}a también lo es. Para ello, sea ε \PYGZgt{} 0. Tenemos}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que demostrar que existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N, ∀ m ≥ N, |(\PYGZhy{}a)(m) \PYGZhy{} (\PYGZhy{}a)(n)| \PYGZlt{} ε                 (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que a es de Cauchy, existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N, ∀ m ≥ N, |a(m) \PYGZhy{} a(n)| \PYGZlt{} ε                       (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que con el mismo N se verifica la condición (1). Para}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ello, sean n y m tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ N                                                     (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    m ≥ N                                                     (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |(\PYGZhy{}a)(m) \PYGZhy{} (\PYGZhy{}a)(n)| = |(\PYGZhy{}a(m)) \PYGZhy{} (\PYGZhy{}a(n))|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                        = |\PYGZhy{}(a(m) \PYGZhy{} a(n))|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                        = |a(m) \PYGZhy{} a(n)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                        \PYGZlt{} ε                  [por (2), (3) y (4)]}

