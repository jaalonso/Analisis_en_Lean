\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que si aₙ es una sucesión y L y M son límites de}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} aₙ, entonces L = M. Lo haremos por contradicción. Para ello,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} supongamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    L ≠ M.                                                         (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε = |L \PYGZhy{} M|                                                    (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar una contradicción, para lo que basta probar}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que ε \PYGZlt{} ε.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} De (1) se sigue que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε = |L \PYGZhy{} M| \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} de donde}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε/2 \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Teniendo en cuenta que aₙ converge a L y a M, y usando ε/2, existen}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} k₁ y k₂ tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k₁, |aₙ \PYGZhy{} L| \PYGZlt{} ε/2                                       (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k₂, |aₙ \PYGZhy{} M| \PYGZlt{} ε/2                                       (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k = máx(k₁, k₂)                                                (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k ≥ k₁                                                         (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    k ≥ k₂                                                         (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} De (3) y (5), se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₖ \PYGZhy{} L| \PYGZlt{} ε/2                                                 (8)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} De (4) y (7), se tiene}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₖ \PYGZhy{} M| \PYGZlt{} ε/2                                                 (9)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} De lo anterior, se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε = |L \PYGZhy{} M|                 [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |(L \PYGZhy{} M) + (aₖ \PYGZhy{} aₖ)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |(L \PYGZhy{} aₖ) + (aₖ \PYGZhy{} M)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ |L \PYGZhy{} aₖ| + |aₖ \PYGZhy{} M|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = |aₖ \PYGZhy{} L| + |aₖ \PYGZhy{} M|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZlt{} ε/2 + ε/2               [por (8) y (9)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = ε}

