\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostrar la desigualdad triangular inversa; es decir, que para}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} cualesquiera números reales x e y, se cumple la siguiente relación:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ||x| \PYGZhy{} |y|| ≤ |x \PYGZhy{} y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ||x| \PYGZhy{} |y|| ≤ |x \PYGZhy{} y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} es suficiente demostrar estas dos desigualdades}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |x| \PYGZhy{} |y| ≤ |x \PYGZhy{} y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}     \PYGZhy{}(|x| \PYGZhy{} |y|) ≤ |x \PYGZhy{} y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} La demostración de la primera es}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |x| \PYGZhy{} |y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = |(x \PYGZhy{} y) + y| \PYGZhy{} |y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ≤ (|x \PYGZhy{} y| + |y|) \PYGZhy{} |y|    [por desigualdad triangular]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = |x \PYGZhy{} y|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y la de la segunda es}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}(|x| \PYGZhy{} |y|)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = |y| \PYGZhy{} |x|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = |x \PYGZhy{} (x \PYGZhy{} y)| \PYGZhy{} |x|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ≤ (|x| + |x \PYGZhy{} y|) \PYGZhy{} |x|    [por desigualdad triangular]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = |x \PYGZhy{} y|}

