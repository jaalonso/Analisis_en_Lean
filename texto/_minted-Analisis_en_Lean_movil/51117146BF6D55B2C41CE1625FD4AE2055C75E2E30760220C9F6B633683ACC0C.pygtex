\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea ε \PYGZgt{} 0. Tenemos que demostrar que existe un N tal que,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N, |bₙ \PYGZhy{} L| \PYGZlt{} ε                                          (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que a y c convergen a L, existen N₁ y ℕ₂ tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N₁, |aₙ \PYGZhy{} L| \PYGZlt{} ε                                         (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N₂, |cₙ \PYGZhy{} L| \PYGZlt{} ε                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    N = máx(N₁, ℕ₂).                                               (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrar (1), sea n ≥ N. Por  (4), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ N₁}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ N₂}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego, usando (2) y (3), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ \PYGZhy{} L| \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |cₙ \PYGZhy{} L| \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} de donde se deduce que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{} ε \PYGZlt{} aₙ \PYGZhy{} L \PYGZlt{} ε                                               (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{} ε \PYGZlt{} bₙ \PYGZhy{} L \PYGZlt{} ε                                               (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}ε \PYGZlt{} aₙ \PYGZhy{} L   [por (5)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       ≤ bₙ \PYGZhy{} L   [por hipótesis de b]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       ≤ cₙ \PYGZhy{} L   [por hipótesis de b]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}       \PYGZlt{} ε        [por (6)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}ε \PYGZlt{} bₙ \PYGZhy{} L \PYGZlt{} ε}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, finalmente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |bₙ \PYGZhy{} L| \PYGZlt{} ε}

