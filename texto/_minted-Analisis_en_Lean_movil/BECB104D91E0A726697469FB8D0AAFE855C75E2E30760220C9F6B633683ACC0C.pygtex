\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 1ª demostración}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ===============}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Como 2 y 3 son primos entre sí, para demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} n(n+1)(2n+1) es divisible por 6 basta demostrar que lo es}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} por 2 y por 3.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrar que n(n+1)(2n+1) es divisible por 2,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} consideramos dos casos según el resto de dividir n entre}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 2; es decir, según el valor de n \PYGZpc{} 2.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 1: Si n \PYGZpc{} 2 = 0, entonces n es divible entre 2 y, por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tanto, también lo es n(n+1)(2n+1).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 2: Si n \PYGZpc{} 2 = 1, entonces n+1 es divible entre 2 y,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} por tanto, también lo es n(n+1)(2n+1).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrar que n(n+1)(2n+1) es divisible por 3,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} consideramos tres casos según el resto de dividir n entre}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 3; es decir, según el valor de n \PYGZpc{} 3.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 1: Si n \PYGZpc{} 3 = 0, entonces n es divible entre 3 y, por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tanto, también lo es n(n+1)(2n+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 2: Si n \PYGZpc{} 3 = 1, entonces 2n+1 es divible entre 3 y,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} por tanto, también lo es n(n+1)(2n+1).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Caso 3: Si n \PYGZpc{} 3 = 2, entonces n+1 es divible entre 3 y,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} por tanto, también lo es n(n+1)(2n+1).}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 2ª demostración}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ===============}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraremos, por inducción en n, que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    6 ∣ n(n+1)(2n+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Base: Para n = 0, se tiene trivialmente que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    6 | 0 * (0 + 1) * (2 * 0 + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Paso de inducción: Supongamos que n verifica la hipótesis}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} de inducción:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    6 ∣ n(n+1)(2n+1)                                    (HI)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    6 ∣ (n+1)((n+1)+1)(2(n+1)+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por la HI, existe un k tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n(n+1)(2n+1) = 6k                                   (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} La diferencia es}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n+1)((n+1)+1)(2(n+1)+1) \PYGZhy{} n(n+1)(2n+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = (n+1)(n+2)(2n+3) \PYGZhy{} n(n+1)(2n+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = (n+1)[(n+2)(2n+3) \PYGZhy{} n(2n+1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = (n+1)[2n² + 7n + 6 \PYGZhy{} 2n² \PYGZhy{} n]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = (n+1)(6n + 6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = 6(n+1)²}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (n+1)((n+1)+1)(2(n+1)+1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = n(n+1)(2n+1) + 6(n+1)²}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = 6k + 6(n+1)²             [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = 6(k + (n+1)²)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que es divisible por 6.}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 3ª demostración}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ===============}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Usando aritmética modular en ℤ₆, demostrar que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    6 ∣ n * (n + 1) * (2 * n + 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} se reduce a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n * (n + 1) * (2 * n + 1) ≡ 0 (mod 6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} lo que se verifica trivialmente.}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones en Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ========================}

