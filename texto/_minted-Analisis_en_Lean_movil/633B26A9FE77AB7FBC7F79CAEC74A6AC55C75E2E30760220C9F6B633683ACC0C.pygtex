\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que a converge a L, existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∀ n ≥ N) |aₙ \PYGZhy{} L| \PYGZlt{} 1                                          (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∀ n ≥ N) [aₙ ≥ L \PYGZhy{} 1]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En efecto, sea n ≥ N. Por (1),}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ \PYGZhy{} L| \PYGZlt{} 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}1 \PYGZlt{} aₙ \PYGZhy{} L ∧ aₙ \PYGZhy{} L \PYGZlt{} 1}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ==\PYGZgt{} \PYGZhy{}1 \PYGZlt{} aₙ \PYGZhy{} L}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ==\PYGZgt{} aₙ ≥ L \PYGZhy{} 1}

