\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      (hφ : ∀ n, φ n \PYGZlt{} φ (n + 1))}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      : IsExtraction φ :=}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    strictMono\PYGZus{}nat\PYGZus{}of\PYGZus{}lt\PYGZus{}succ hφ}
