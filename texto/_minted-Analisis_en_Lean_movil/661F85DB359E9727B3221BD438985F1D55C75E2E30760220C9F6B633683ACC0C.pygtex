\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que a converge a 5, existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∀ n ≥ N) |aₙ \PYGZhy{} 5| \PYGZlt{} 5                                          (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    (∀ n ≥ N) [aₙ \PYGZgt{} 0]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En efecto, sea n ≥ N. Por (1),}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ \PYGZhy{} 5| \PYGZlt{} 5}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZhy{}5 \PYGZlt{} aₙ \PYGZhy{} 5 ∧ aₙ \PYGZhy{} 5 \PYGZlt{} 5}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ==\PYGZgt{} \PYGZhy{}5 \PYGZlt{} aₙ \PYGZhy{} 5}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ==\PYGZgt{} aₙ \PYGZgt{} 0}

