\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea bₙ = |aₙ|, para todo n. Tenemos que demostrar que bₙ converge a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} |L|. Para ello, sea ε \PYGZgt{} 0 y tenemos que demostrar que existe un k tal}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} que,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |bₙ \PYGZhy{} |L|| \PYGZlt{} ε                                        (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que aₙ converge a L, existe un k tal que,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |aₙ \PYGZhy{} L| \PYGZlt{} ε                                          (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que para dicho k se cumple (1). En efecto, sea}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ k.                                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Entonces,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |bₙ \PYGZhy{} |L|| = ||aₙ| \PYGZhy{} |L||}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}               ≤ |aₙ \PYGZhy{} L|     [por la desigualdad triangular inversa]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}               \PYGZlt{} ε            [por (2) y (3)]}

