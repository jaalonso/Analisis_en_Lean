\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea ε ∈ ℝ tal que ε \PYGZgt{} 0. Tenemos que demostrar que existe un}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} k ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ p ≥ k, ∀ q ≥ k, |u(p) \PYGZhy{} u(q)| \PYGZlt{} ε                      (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que u es convergente, existe un a ∈ ℝ tal que el límite}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} de u es a. Por tanto, existe un k ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |u(n) \PYGZhy{} a| \PYGZlt{} ε/2                                (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrar que con dicho k se cumple (1), sean p, q ∈ ℕ}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tales que p ≥ k y q ≥ k. Entonces, por (2), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |u(p) \PYGZhy{} a| \PYGZlt{} ε/2                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |u(q) \PYGZhy{} a| \PYGZlt{} ε/2                                         (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |u(p) \PYGZhy{} u(q)| = |(u(p) \PYGZhy{} a) + (a \PYGZhy{} u(q))|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                  ≤ |u(p) \PYGZhy{} a|  + |a \PYGZhy{} u(q)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                  = |u(p) \PYGZhy{} a|  + |u(q) \PYGZhy{} a|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                  \PYGZlt{} ε/2 + ε/2                    [por (3) y (4)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}                  = ε}

