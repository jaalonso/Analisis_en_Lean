\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea ε ∈ ℝ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε \PYGZgt{} 0                                                     (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ p ≥ N, ∀ q ≥ N, |(a + b) p \PYGZhy{} (a + b) q| \PYGZlt{} ε             (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (1), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ε/2 \PYGZgt{} 0                                                   (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, puesto que aₙ es de Cauchy, existe un N₁ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ p ≥ N₁, ∀ q ≥ N₁, |a p \PYGZhy{} a q| \PYGZlt{} ε/2                     (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, puesto que bₙ es de Cauchy, existe un N₂ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ p ≥ N₂, ∀ q ≥ N₂, |b p \PYGZhy{} b q| \PYGZlt{} ε/2                     (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sean}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    N = máx(N₁, N₂)                                           (6)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que con N se verifica (2). Para ello, sean p y q}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} tales que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   p ≥ N                                                      (7)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   q ≥ N                                                      (8)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (7), (8) y (6), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   p ≥ N₁ y q ≥ N₁}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por (4), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   |a p \PYGZhy{} a q| \PYGZlt{} ε/2                                          (9)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por (7), (8) y (6), también se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   p ≥ N₂ y q ≥ N₂}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por (5), se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   |b p \PYGZhy{} b q| \PYGZlt{} ε/2                                         (10)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Finalmente,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |(a + b) p \PYGZhy{} (a + b) q|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = |(a p \PYGZhy{} a q) + (b p \PYGZhy{} b q)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ≤ |a p \PYGZhy{} a q| + |b p \PYGZhy{} b q|    [por la desigualdad triangular]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    \PYGZlt{} ε/2 + ε/2                    [por (9) y (10)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    = ε}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones en Lean 4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ========================}

