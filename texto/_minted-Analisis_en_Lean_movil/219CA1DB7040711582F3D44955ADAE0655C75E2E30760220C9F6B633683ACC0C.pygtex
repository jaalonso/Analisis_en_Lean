\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sea bₙ la suceción definida por}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    bₙ = 2aₙ                                                        (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Tenemos que demostrar que para cada ε \PYGZgt{} 0, existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N, |bₙ \PYGZhy{} 2L| \PYGZlt{} ε                                          (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Puesto que aₙ converge a L, existe un N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N, |aₙ \PYGZhy{} L| \PYGZlt{} ε/2                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que N también cumple (2). En efecto, sea n ≥ N. Entonces}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |bₙ \PYGZhy{} 2L| = |2aₙ \PYGZhy{} 2L|     [por (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = 2|aₙ \PYGZhy{} L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              \PYGZlt{} 2ε/2           [por (3)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}              = ε}

