\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para demostrarlo por reducción al absurdo, supongamos que existe un}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} L ∈ ℝ tal que aₙ converge a L y}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∣L∣ \PYGZlt{} 5.                                                      (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por la definición de límite, existe N ∈ ℕ tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ N, ∣aₙ − L∣ \PYGZlt{} 5                                         (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Por hipótesis sobre la sucesión, para ese mismo N existe tal que se}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} cumplen las siguientes dor relaciones:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    n ≥ N                                                         (3)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∣aₙ∣ \PYGZgt{} 10                                                     (4)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} De (2) y (3) se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∣aₙ − L∣ \PYGZlt{} 5                                                  (5)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Para obtener una contradicción basta probar que 0 \PYGZlt{} 0, como se}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} muestra a continuación:}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    0 \PYGZlt{} ∣aₙ∣              [por (4)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = ∣(aₙ − L) + L∣}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      ≤ ∣aₙ − L∣ + ∣L∣}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      \PYGZlt{} 5 + 5             [por (5) y (1)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}      = 10.}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostraciones con Lean4}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ========================}

