\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostrar que si una sucesión es convergente, entonces sus términos}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} están eventualmente acotados inferiormente por la mitad del valor}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} absoluto del límite; es decir, si una sucesión a converge a L con L ≠}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 0, entonces existe k tal que para todo n ≥ k se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} |aₙ| ≥ |L|/2.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Demostración en lenguaje natural}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ================================}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Se distinguen dos casos según (L = 0).}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Primer caso: Supongamos que L = 0. Entonces, basta tomar el índice 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} ya que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ 0, |a n| ≥ 0 = |0| / 2 = |L| / 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Sefundo caso: Supongamos que L ≠ 0. Entonces se tiene que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |L| / 2 \PYGZgt{} 0}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, como a converge a L, existe un k tal que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |aₙ \PYGZhy{} L| \PYGZlt{} |L| / 2                                    (1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Veamos que}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    ∀ n ≥ k, |aₙ| ≥ |L|/2.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} En efecto, sea n ≥ k. Entonces, por (1),}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ \PYGZhy{} L| \PYGZlt{} |L| / 2                                             (2)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Además,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |L| = |aₙ + (L \PYGZhy{} aₙ)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        ≤ |aₙ| + |L \PYGZhy{} aₙ|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        = |aₙ| + |\PYGZhy{}(aₙ \PYGZhy{} L)|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        = |aₙ| + |aₙ \PYGZhy{} L|}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}        ≤ |aₙ| + |L| / 2      [por (2)]}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Luego,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |L| ≤ |aₙ| + |L| / 2}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} y, por tanto,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{}    |aₙ| ≥ |L|/2}

